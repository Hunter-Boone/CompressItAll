---
source: crates/cia-ffmpeg/src/command.rs
expression: render(&encode_args(&j))
---
-hide_banner -nostdin -y -progress pipe:1 -nostats -v error -i clip.mp4 -filter_complex [0:v:0]scale=1280:720:flags=lanczos,setsar=1[v] -map [v] -c:v h264_videotoolbox -profile:v high -b:v 2000000 -maxrate 2400000 -bufsize 4000000 -allow_sw 1 -realtime 0 -fps_mode cfr -r 30 -pix_fmt yuv420p -map_metadata -1 -map_chapters -1 -movflags +faststart clip.partial.mp4
