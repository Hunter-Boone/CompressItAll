---
source: crates/cia-ffmpeg/src/command.rs
expression: render(&single)
---
-hide_banner -nostdin -y -progress pipe:1 -nostats -v error -vaapi_device /dev/dri/renderD128 -i clip.mp4 -filter_complex "[0:v:0]scale=1280:720:flags=lanczos,setsar=1,format=nv12,hwupload[v];[0:a:0]aresample=async=1:first_pts=0[a]" -map [v] -map [a] -c:v h264_vaapi -rc_mode VBR -b:v 2000000 -maxrate 2600000 -fps_mode cfr -r 30 -c:a aac -b:a 128000 -ac 2 -map_metadata -1 -map_chapters -1 -movflags +faststart clip.partial.mp4
