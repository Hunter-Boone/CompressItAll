{
  "name": "compressitall",
  "private": true,
  "version": "0.1.0",
  "description": "Smidge monorepo: shared UI, web app, desktop app, site",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "for p in packages/api-types packages/engine-client packages/webvideo packages/ui apps/web apps/desktop apps/site; do echo \"== $p\"; npx tsc -p $p/tsconfig.json --noEmit || exit 1; done",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "licenses:npm": "license-checker-rseidelsohn --production --json --excludePrivatePackages",
    "e2e:web": "playwright test -c e2e/web/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module"
}
