# Smidge site environment (docs/DESIGN.md 5.13). Copy to .env.local for development.
# Every value below is a placeholder; lib/env.ts refuses to start with any of them.
# Secrets: `openssl rand -base64 32` (16 for IP_HASH_SALT). License seed: `cargo xtask keygen license`.

NEXT_PUBLIC_SITE_URL=http://localhost:3031
NEXT_PUBLIC_APP_URL=http://localhost:5181

# "memory" runs the API against an in-memory database (dev and tests). Anything else uses Supabase.
SMG_DB=memory
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# sandbox or production; keys must match (pdl_sdbx_ / pdl_live_, test_ / live_).
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_placeholder
PADDLE_WEBHOOK_SECRET=pdl_ntfset_placeholder
PADDLE_PRICE_ID_LIFETIME=pri_placeholder_lifetime
PADDLE_PRICE_ID_YEARLY=pri_placeholder_yearly
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_placeholder

RESEND_API_KEY=re_placeholder
EMAIL_FROM=Smidge <hello@mail.placeholder.example>
EMAIL_REPLY_TO=support@placeholder.example

# base64 of the 32-byte Ed25519 seed; the kid must exist in crates/cia-license/src/keys.rs
LICENSE_SIGNING_KEY=placeholder
LICENSE_SIGNING_KID=2026-10
# base64 of 32 random bytes
KEY_ENCRYPTION_KEY=placeholder
OTP_PEPPER=placeholder
# base64 of 16 random bytes
IP_HASH_SALT=placeholder
CRON_SECRET=placeholder
ADMIN_ALERT_EMAIL=hunter@placeholder.example
